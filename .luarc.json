{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "?.lua",
    "?/init.lua"
  ],
  "workspace.library": [
    "${3rd}/love2d/library"
  ],
  "workspace.checkThirdParty": false,
  "workspace.ignoreDir": [
    "build",
    "dist",
    ".git"
  ],
  "workspace.maxPreload": 20000,
  "workspace.preloadFileSize": 2000,
  "diagnostics.globals": [
    "love"
  ]
}
